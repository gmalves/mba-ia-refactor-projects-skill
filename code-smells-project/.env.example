# Configuração da aplicação — copie para .env e ajuste conforme o ambiente.
# Nenhum valor real deve ser versionado.

# Chave de assinatura da aplicação (se ausente, uma aleatória é gerada por boot)
SECRET_KEY=

# Ativa o modo debug do Flask (default: false)
FLASK_DEBUG=false

# Interface e porta HTTP (defaults: 127.0.0.1:5000)
HOST=127.0.0.1
PORT=5000

# Caminho do banco SQLite (default: loja.db)
DB_PATH=loja.db

# Token exigido no header X-Admin-Token para os endpoints /admin/*
# Em produção, defina um valor forte e único.
ADMIN_TOKEN=dev-admin-token

# Rótulo de ambiente exibido no healthcheck (default: producao)
AMBIENTE=producao
