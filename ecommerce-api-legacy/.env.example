# Configuração da aplicação — copie para .env e ajuste conforme o ambiente.
# Nenhum valor real deve ser versionado.

# Porta HTTP do servidor (default: 3000)
PORT=3000

# Token exigido no header X-Admin-Token para endpoints administrativos
# (GET /api/admin/financial-report, DELETE /api/users/:id).
# Em produção, defina um valor forte e único.
ADMIN_TOKEN=dev-admin-token
