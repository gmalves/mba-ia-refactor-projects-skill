# Configuração da aplicação — copie para .env e ajuste conforme o ambiente.
# Nenhum valor real deve ser versionado.

# Chave de sessão (se ausente, uma aleatória é gerada por boot)
SECRET_KEY=

# URI do banco (default: sqlite:///tasks.db)
DATABASE_URL=sqlite:///tasks.db

# Debug e bind (defaults seguros: false, 127.0.0.1:5000)
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Token de admin para endpoints destrutivos (header X-Admin-Token)
ADMIN_TOKEN=dev-admin-token

# SMTP (opcional) — usado pelo serviço de notificação
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
